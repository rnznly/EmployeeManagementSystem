      <Column Name="CreatedAt" Type="System.DateTime" DbType="DateTime2(0) NOT NULL" CanBeNull="false" />
      <Association Name="FK_Employees_Departments" Member="Employees" ThisKey="DepartmentId" OtherKey="DepartmentId" Type="Employees" DeleteRule="SET NULL" />
    </Type>
  </Table>
  <Table Name="dbo.Employees" Member="Employees">
