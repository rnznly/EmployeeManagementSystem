      <Column Name="UpdatedAt" Type="System.DateTime" DbType="DateTime2(0) NOT NULL" CanBeNull="false" />
      <Association Name="FK_Employees_Departments" Member="Departments" ThisKey="DepartmentId" OtherKey="DepartmentId" Type="Departments" IsForeignKey="true" />
      <Association Name="FK_History_Employee" Member="EmploymentHistory" ThisKey="EmployeeId" OtherKey="EmployeeId" Type="EmploymentHistory" DeleteRule="CASCADE" />
    </Type>
  </Table>
  <Table Name="dbo.EmploymentHistory" Member="EmploymentHistory">
    <Type Name="EmploymentHistory">
      <Column Name="HistoryId" Type="System.Int64" DbType="BigInt NOT NULL IDENTITY" IsPrimaryKey="true" IsDbGenerated="true" CanBeNull="false" />
