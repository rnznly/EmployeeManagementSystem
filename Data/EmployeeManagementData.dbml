      <Column Name="ReasonForLeaving" Type="System.String" DbType="VarChar(255)" CanBeNull="true" />
      <Column Name="Notes" Type="System.String" DbType="VarChar(MAX)" CanBeNull="true" UpdateCheck="Never" />
      <Column Name="CreatedAt" Type="System.DateTime" DbType="DateTime2(0) NOT NULL" CanBeNull="false" />
      <Association Name="FK_History_Employee" Member="Employees" ThisKey="EmployeeId" OtherKey="EmployeeId" Type="Employees" IsForeignKey="true" DeleteOnNull="true" />
