<?xml version="1.0" encoding="utf-8"?>
<Database Name="EmployeeManagementDB" EntityNamespace="EmployeeManagementSystem.Data" ContextNamespace="EmployeeManagementSystem.Data" Class="EmployeeManagementDataContext" xmlns="http://schemas.microsoft.com/linqtosql/dbml/2007">
  <Table Name="dbo.Departments" Member="Departments">
    <Type Name="Departments">
      <Column Name="DepartmentId" Type="System.Int32" DbType="Int NOT NULL IDENTITY" IsPrimaryKey="true" IsDbGenerated="true" CanBeNull="false" />
      <Column Name="DepartmentCode" Type="System.String" DbType="VarChar(20) NOT NULL" CanBeNull="false" />
